<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>VkRadio.Patterns.Guards</PackageId>
    <Version>0.0.2</Version>
    <Authors>vkradio</Authors>
    <Description>Generalized implementation of Guard Clauses design pattern</Description>
    <PackageProjectUrl>https://github.com/vkradio/VkRadio.Patterns.Guards</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vkradio/VkRadio.Patterns.Guards</RepositoryUrl>
    <PackageTags>patterns;guards;guard clauses</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
